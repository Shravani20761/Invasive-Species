ENVIRONMENT=development
SECRET_KEY=dev-only-change-me-use-a-long-random-string
DATABASE_URL=sqlite:///./invasive_species_radar.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INFERENCE_MODE=demo
# Use bioclip on a host with enough memory to score real photographs with TreeOfLife-10M.
# INFERENCE_MODE=bioclip
SEED_ON_STARTUP=true
LOW_CONFIDENCE_THRESHOLD=0.45
# Leave empty unless a local YOLO weights file is available.
YOLO_WEIGHTS=
# PostgreSQL + PostGIS example for Docker Compose:
# DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/invasive_species_radar
# Supabase Postgres. The API uses DATABASE_URL, not the Supabase client.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
